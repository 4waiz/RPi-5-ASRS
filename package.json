{
  "name": "edge-asrs-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:frontend": "vite",
    "dev:alerts": "cd backend && python -m uvicorn app_alerts:app --host 0.0.0.0 --port 8000 --reload",
    "dev:assistant": "cd backend && python app_aiassistant.py",
    "dev:backend": "concurrently -k -n alerts,assistant \"npm:dev:alerts\" \"npm:dev:assistant\"",
    "dev:front-after-backend": "wait-on tcp:8000 tcp:8001 && npm run dev:frontend",
    "dev:stack": "concurrently -k -n backend,front \"npm:dev:backend\" \"npm:dev:front-after-backend\"",
    "build": "vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/three": "^0.181.0",
    "concurrently": "^9.2.1",
    "svelte": "^5.39.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "marked": "^11.2.0",
    "three": "^0.181.1"
  }
}
