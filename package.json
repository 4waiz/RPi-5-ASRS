{
  "name": "rpi5-asrs",
  "version": "1.0.0",
  "private": true,
  "description": "RPi-5 ASRS - Automated Storage and Retrieval System",
  "scripts": {
    "dev": "npm --prefix frontend run dev:stack",
    "dev:frontend": "npm --prefix frontend run dev:frontend",
    "dev:backend": "npm --prefix frontend run dev:backend",
    "build": "npm --prefix frontend run build",
    "install:frontend": "cd frontend && npm install",
    "install:all": "npm run install:frontend"
  },
  "workspaces": [
    "frontend"
  ]
}
