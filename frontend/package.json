{
  "name": "edge-asrs-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:frontend": "vite",
    "dev:alerts": "cd ../backend && .venv\\Scripts\\python -m uvicorn app_alerts:app --host 0.0.0.0 --port 8000 --reload",
    "dev:assistant": "cd ../backend && .venv\\Scripts\\python app_aiassistant.py",
    "dev:models": "cd ../backend && .venv\\Scripts\\python -m uvicorn app_models:app --host 127.0.0.1 --port 8013 --reload",
    "dev:backend": "concurrently -k -n alerts,assistant,models \"npm:dev:alerts\" \"npm:dev:assistant\" \"npm:dev:models\"",
    "dev:all": "concurrently -k -n backend,frontend \"npm:dev:backend\" \"npm:dev:frontend\"",
    "build": "vite build",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@types/three": "^0.181.0",
    "concurrently": "^9.2.1",
    "svelte": "^5.39.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "wait-on": "^7.2.0"
  },
  "dependencies": {
    "marked": "^11.2.0",
    "three": "^0.181.1"
  }
}
